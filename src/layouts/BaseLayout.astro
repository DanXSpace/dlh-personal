---
import { Font } from 'astro:assets';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import Seo from '../components/layout/Seo.astro';
import type { SeoDetails } from '../lib/seo.ts';
import { THEME_INIT_SCRIPT } from '../lib/theme.ts';
import '../styles/global.css';

/**
 * A page passes its title and description; that is all an ordinary page needs
 * for complete search and social metadata (architecture §10):
 *
 *   <BaseLayout title="Now" description="One or two sentences about the page.">
 */
interface Props {
  /** The page's own title, shown as `Title — Daniel Lee Holung`. Omit on the homepage only. */
  title?: string;
  /** One or two sentences for search results and link previews, up to 160 characters. */
  description: string;
  /** Entry pages only (article and case-study layouts): image, dates, breadcrumbs, structured data. */
  seo?: SeoDetails | undefined;
}

const { title, description, seo } = Astro.props;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <!-- Render-blocking on purpose: applies a stored theme before first paint. -->
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} seo={seo} />
    <Font cssVariable="--font-geist-sans" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-geist-mono" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only z-10 border border-control-border bg-bg font-mono text-label uppercase tracking-label focus:not-sr-only focus:fixed focus:top-4 focus:left-gutter focus:inline-flex focus:min-h-target focus:items-center focus:px-3"
    >
      Skip to content
    </a>
    <Header />
    <!-- tabindex="-1" lets the skip link move focus here, not just scroll. -->
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
