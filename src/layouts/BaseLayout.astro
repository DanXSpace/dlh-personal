---
import { Font } from 'astro:assets';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { resolveSiteEnv } from '../lib/site-env.ts';
import { THEME_INIT_SCRIPT } from '../lib/theme.ts';
import { site } from '../site.config.ts';
import '../styles/global.css';

interface Props {
  /** Page-specific title. Omit on the homepage to use the site name alone. */
  title?: string;
}

const { title } = Astro.props;
const documentTitle = title ? `${title} — ${site.name}` : site.name;
const { indexable } = resolveSiteEnv(process.env);
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <!-- Render-blocking on purpose: applies a stored theme before first paint. -->
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <Font cssVariable="--font-geist-sans" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-geist-mono" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only z-10 border border-control-border bg-bg font-mono text-label uppercase tracking-label focus:not-sr-only focus:fixed focus:top-4 focus:left-gutter focus:inline-flex focus:min-h-target focus:items-center focus:px-3"
    >
      Skip to content
    </a>
    <Header />
    <!-- tabindex="-1" lets the skip link move focus here, not just scroll. -->
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
