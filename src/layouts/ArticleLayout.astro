---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import TableOfContents from '../components/ui/TableOfContents.astro';
import { categoryLabels } from '../lib/categories.ts';
import { formatDate, isoDate } from '../lib/dates.ts';
import { blogPosting } from '../lib/json-ld.ts';
import { readingMinutes } from '../lib/reading-time.ts';
import { socialImage } from '../lib/social-image.ts';
import { tableOfContents } from '../lib/toc.ts';
import { site } from '../site.config.ts';
import '../styles/prose.css';
import BaseLayout from './BaseLayout.astro';

interface Props {
  article: CollectionEntry<'writing'>;
  headings: MarkdownHeading[];
}

const { article, headings } = Astro.props;
const { title, description, deck, published, updated, category, toc, ogImage } = article.data;
const minutes = readingMinutes(article.body ?? '');
const contents = tableOfContents(headings, toc);

const path = Astro.url.pathname;
const image = await socialImage(ogImage);
const seo = {
  image,
  article: { published, updated },
  breadcrumbs: [
    { label: 'Writing', href: '/writing' },
    { label: title, href: path },
  ],
  structuredData: [blogPosting({ title, description, published, updated, path, image: image.src }, site.origin)],
};
---

<!--
  Article page (design-spec §4 `/writing/[slug]`). The header and prose share
  the 680px reading column at the leading edge of the shell; at 1024px and up
  the table of contents sits in the space to its right, an asymmetric split.
  `data-pagefind-body` marks what full-text search indexes: the title, the
  deck and the body (src/lib/search-index.ts).
-->
<BaseLayout title={title} description={description} seo={seo}>
  <article class="article mx-auto max-w-shell px-gutter py-section" class:list={{ 'has-contents': contents.length > 0 }}>
    <header class="article-header flex max-w-measure flex-col items-start gap-6">
      <p class="flex flex-wrap gap-x-3 font-mono text-label uppercase tracking-label text-muted">
        <span>{categoryLabels[category]}</span>
        <span aria-hidden="true">/</span>
        <time datetime={isoDate(published)}>{formatDate(published)}</time>
      </p>
      <h1 class="text-page-heading leading-heading font-medium" data-pagefind-body>{title}</h1>
      {deck && <p class="text-body-large text-muted" data-pagefind-body>{deck}</p>}
      <p class="flex flex-wrap gap-x-3 gap-y-1 font-mono text-label tracking-label text-muted">
        <span>By {site.name}</span>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {
          updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time>
              </span>
            </>
          )
        }
      </p>
    </header>

    {
      contents.length > 0 && (
        <div class="article-contents">
          <TableOfContents items={contents} />
        </div>
      )
    }

    <div class="article-body prose" data-pagefind-body>
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  @reference '../styles/global.css';

  .article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: calc(var(--space-unit) * 12);
  }

  /*
   * 1024px and up: reading column on the left, contents beside it, staying in
   * view while the article scrolls.
   */
  @media (width >= theme(--breakpoint-lg)) {
    .article.has-contents {
      grid-template-columns: minmax(0, var(--measure)) minmax(0, 1fr);
      column-gap: calc(var(--space-unit) * 12);
    }

    .has-contents .article-header {
      grid-column: 1 / -1;
    }

    .has-contents .article-contents {
      grid-column: 2;
      grid-row: 2;
      align-self: start;
      position: sticky;
      top: calc(var(--space-unit) * 8);
    }

    .has-contents .article-body {
      grid-column: 1;
      grid-row: 2;
    }
  }
</style>
