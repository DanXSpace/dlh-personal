---
/**
 * A numbered homepage section (design-spec §4 `/`): a mono `01 / SELECTED
 * WORK` label with a link to the full page, then the section's content. The
 * number is decoration, so the section's accessible name is its title alone.
 * The homepage leaves a section out entirely when it has nothing to show.
 */
import type { Link } from '../../lib/links.ts';
import TextLink from '../ui/TextLink.astro';

interface Props {
  number: number;
  title: string;
  /** Unique id for the heading, which names the section. */
  id: string;
  /** The page this section summarizes. */
  link: Link;
  /** An optional sentence or two introducing the section, under its label. */
  intro?: string | undefined;
}

const { number, title, id, link, intro } = Astro.props;
---

<section class="home-section" aria-labelledby={id}>
  <header class="home-section-header">
    <h2 id={id} class="home-section-title font-mono text-label tracking-label text-muted">
      <span aria-hidden="true">{String(number).padStart(2, '0')} / </span>{title}
    </h2>
    <TextLink href={link.href}>{link.label}</TextLink>
  </header>
  {intro && <p class="home-section-intro text-body-large text-muted">{intro}</p>}
  <slot />
</section>

<style>
  .home-section {
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-unit) * 4);
  }

  .home-section-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: calc(var(--space-unit) * 6);
  }

  .home-section-title {
    text-transform: uppercase;
  }

  .home-section-intro {
    max-width: var(--measure);
    margin: 0;
    margin-block-end: calc(var(--space-unit) * 4);
  }
</style>
