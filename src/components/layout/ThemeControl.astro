---
import type { ThemeChoice } from '../../lib/theme.ts';

const options: { value: ThemeChoice; label: string }[] = [
  { value: 'system', label: 'System' },
  { value: 'light', label: 'Light' },
  { value: 'dark', label: 'Dark' },
];
---

<!--
  Appearance selector (architecture §8): three native radios, so the group's
  name, each option's name, the selected state and arrow-key operation all come
  from the platform. Each radio covers its label, making the whole 44 × 44 px
  box the target and drawing the focus ring around it. Hidden without JS.
-->
<fieldset class="inline-flex rounded-sm border border-control-border" data-theme-control data-requires-js>
  <legend class="sr-only">Theme</legend>
  {
    options.map(({ value, label }) => (
      <label class="relative inline-flex min-h-target min-w-target items-center justify-center px-3 font-mono text-label uppercase tracking-label text-muted transition-colors hover:text-text has-checked:bg-text has-checked:text-bg">
        <input
          class="absolute inset-0 cursor-pointer appearance-none"
          type="radio"
          name="theme"
          value={value}
          checked={value === 'system'}
        />
        {label}
      </label>
    ))
  }
</fieldset>

<script>
  import { THEME_STORAGE_KEY, type ThemeChoice } from '../../lib/theme.ts';

  const root = document.documentElement;

  function storedChoice(): ThemeChoice {
    try {
      const value = localStorage.getItem(THEME_STORAGE_KEY);
      return value === 'light' || value === 'dark' ? value : 'system';
    } catch {
      return 'system';
    }
  }

  function apply(choice: ThemeChoice) {
    if (choice === 'system') delete root.dataset['theme'];
    else root.dataset['theme'] = choice;
    try {
      if (choice === 'system') localStorage.removeItem(THEME_STORAGE_KEY);
      else localStorage.setItem(THEME_STORAGE_KEY, choice);
    } catch {
      // Storage blocked: the choice applies to this page view only.
    }
  }

  const radios = document.querySelectorAll<HTMLInputElement>('[data-theme-control] input[name="theme"]');

  /** Match the radios and <html> to storage, including after a back/forward cache restore. */
  function sync() {
    const choice = storedChoice();
    if (choice === 'system') delete root.dataset['theme'];
    else root.dataset['theme'] = choice;
    for (const radio of radios) radio.checked = radio.value === choice;
  }

  sync();
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) sync();
  });
  for (const radio of radios) {
    radio.addEventListener('change', () => {
      if (radio.checked) apply(radio.value as ThemeChoice);
    });
  }
</script>
