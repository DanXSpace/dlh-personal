---
/**
 * Apartment Hunter case study, figure: the three versions, in order. Each kept
 * Discord as the delivery channel and dropped infrastructure.
 * Drawn twice: side by side from 768px, stacked below (Diagram's
 * `d-wide`/`d-narrow`).
 */
import { arrow } from './svg.ts';

const versions = [
  { stage: '01 / Kafka pipeline', detail: ['Scraper → Kafka', '→ Discord webhook'] },
  { stage: '02 / Browser monitor', detail: ['Chromium', '→ Discord webhook'] },
  { stage: '03 / Discord bot', detail: ['HTTP sources + SQLite', '↔ Discord commands'] },
];

// Wide: three 216-unit boxes with 36-unit gaps, arrows left to right.
const wideBoxes = versions.map((v, i) => ({ ...v, x: i * 252, y: 0, w: 216, h: 92 }));
const wideArrows = [0, 1].map((i) => arrow([[i * 252 + 216, 46], [(i + 1) * 252, 46]]));

// Narrow: full-width boxes stacked, arrows top to bottom.
const narrowBoxes = versions.map((v, i) => ({ ...v, x: 0, y: i * 96, w: 340, h: 72 }));
const narrowArrows = [0, 1].map((i) => arrow([[170, i * 96 + 72], [170, (i + 1) * 96]]));

const drawings = [
  { className: 'd-wide', viewBox: '0 0 720 92', boxes: wideBoxes, arrows: wideArrows, gap: 18 },
  { className: 'd-narrow', viewBox: '0 0 340 264', boxes: narrowBoxes, arrows: narrowArrows, gap: 0 },
];
---

{
  drawings.map(({ className, viewBox, boxes, arrows, gap }) => (
    <svg class={className} viewBox={viewBox} aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
      {boxes.map((b) => (
        <>
          <rect x={b.x + 0.5} y={b.y + 0.5} width={b.w - 1} height={b.h - 1} rx="2" fill="none" stroke="currentColor" stroke-width="1" />
          <text class="d-label" x={b.x + 14} y={b.y + 24 + gap / 2}>{b.stage}</text>
          {gap > 0 ? (
            b.detail.map((line, i) => (
              <text class="d-muted" x={b.x + 14} y={b.y + 51 + i * 18}>{line}</text>
            ))
          ) : (
            <text class="d-muted" x={b.x + 14} y={b.y + 48}>{b.detail.join(' ')}</text>
          )}
        </>
      ))}
      {arrows.map((a) => (
        <>
          <path d={a.path} fill="none" stroke="currentColor" stroke-width="1" />
          <polygon points={a.head} fill="currentColor" />
        </>
      ))}
    </svg>
  ))
}
