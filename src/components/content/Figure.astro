---
/**
 * An image with a mono caption in the spec's `FIG. 01 / ROOTS` form
 * (design-spec §1, §5; architecture §6). The image is optimized at build time
 * into responsive sizes, with its width and height set so the page doesn't
 * shift as it loads.
 *
 *   import roots from './roots.jpg';
 *   <Figure src={roots} alt="Mist over the Blue Mountains." number={1} label="Roots" />
 *
 * `alt` is required: describe the image, or pass `alt=""` when it is purely
 * decorative (design-spec §6). Children, if any, follow the label as a short
 * caption sentence.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { figureImage, figureLabel } from '../../lib/figures.ts';

interface Props {
  src: ImageMetadata;
  alt: string;
  number: number;
  label: string;
}

const { src, alt, number, label } = Astro.props;
if (typeof alt !== 'string') {
  throw new Error(`Figure ${number} needs an \`alt\` description, or \`alt=""\` if the image is purely decorative.`);
}
const caption = figureLabel(number, label);
---

<figure class="figure">
  <Image
    src={src}
    alt={alt}
    widths={[...figureImage.widths]}
    sizes={figureImage.sizes}
    class="figure-image"
  />
  <figcaption class="figure-caption font-mono text-caption tracking-label text-muted">
    <div class="figure-label">{caption}</div>
    {Astro.slots.has('default') && <div class="figure-text"><slot /></div>}
  </figcaption>
</figure>

<style>
  .figure-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }

  .figure-caption {
    display: flex;
    flex-wrap: wrap;
    column-gap: calc(var(--space-unit) * 3);
    margin-block-start: calc(var(--space-unit) * 3);
    line-height: var(--leading-body);
  }

  .figure-text > :global(*) {
    margin: 0;
  }
</style>
