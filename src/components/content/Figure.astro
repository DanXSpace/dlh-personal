---
/**
 * An image with a mono caption in the spec's `FIG. 01 / ROOTS` form
 * (design-spec §1, §5; architecture §6). The image is optimized at build time
 * into responsive sizes, with its width and height set so the page doesn't
 * shift as it loads.
 *
 *   import roots from './roots.jpg';
 *   <Figure src={roots} alt="Mist over the Blue Mountains." number={1} label="Roots" />
 *
 * `alt` is required: describe the image, or pass `alt=""` when it is purely
 * decorative (design-spec §6). Children, if any, follow the label as a short
 * caption sentence. `Gallery` renders its figures through this component and
 * passes `caption` and `sizes` instead.
 *
 * The image ships as AVIF with a WebP fallback, and loads lazily. Pass
 * `priority` only for an image that is visible without scrolling on a desktop,
 * such as the largest image on the page; it loads eagerly at high priority.
 * That is set by hand rather than with Astro's `priority`, which would also
 * decode the image synchronously and hold up the page's first paint.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { figureImage, figureLabel, highPriority, rasterFormats } from '../../lib/figures.ts';

interface Props {
  src: ImageMetadata;
  alt: string;
  number: number;
  label: string;
  /** A caption sentence given as a prop rather than as children. */
  caption?: string | undefined;
  /** Overrides the reading-column `sizes`; set by `Gallery`. */
  sizes?: string;
  /** Loads the image eagerly at high priority, for an image above the fold. */
  priority?: boolean;
}

const { src, alt, number, label, caption: sentence, sizes = figureImage.sizes, priority = false } = Astro.props;
if (typeof alt !== 'string') {
  throw new Error(`Figure ${number} needs an \`alt\` description, or \`alt=""\` if the image is purely decorative.`);
}
const caption = figureLabel(number, label);
---

<figure class="figure">
  <Picture
    {...rasterFormats()}
    src={src}
    alt={alt}
    widths={[...figureImage.widths]}
    sizes={sizes}
    {...(priority ? highPriority : {})}
    class="figure-image"
  />
  <figcaption class="figure-caption font-mono text-caption tracking-label text-muted">
    <div class="figure-label">{caption}</div>
    {sentence && <div class="figure-text">{sentence}</div>}
    {!sentence && Astro.slots.has('default') && <div class="figure-text"><slot /></div>}
  </figcaption>
</figure>

<style>
  .figure-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }

  .figure-caption {
    display: flex;
    flex-wrap: wrap;
    column-gap: calc(var(--space-unit) * 3);
    margin-block-start: calc(var(--space-unit) * 3);
    line-height: var(--leading-body);
  }

  .figure-text > :global(*) {
    margin: 0;
  }
</style>
