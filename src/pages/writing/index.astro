---
import WritingArchiveLayout from '../../layouts/WritingArchiveLayout.astro';
import { categoriesWithArticles } from '../../lib/archive.ts';
import { getPublished } from '../../lib/content.ts';

const articles = await getPublished('writing');
---

<!-- Interim description in plain, factual terms; the owner may replace it (ticket 18). -->
<WritingArchiveLayout
  title="Writing"
  description="Articles and build logs by Daniel Lee Holung."
  articles={articles}
  categories={categoriesWithArticles(articles)}
  deck="Thinking in public."
  intro={[
    'I write to make sense of things. Sometimes that means working through a technical concept, reflecting on something I’ve built or sharing an observation about the world around me.',
    'You’ll find notes on software engineering, technology, learning and whatever else happens to hold my attention.',
  ]}
/>
