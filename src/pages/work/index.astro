---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublished } from '../../lib/content.ts';
import { directoryImage } from '../../lib/figures.ts';
import { directoryOrder, projectStatusLabels, projectTypeLabels } from '../../lib/projects.ts';
import { entryHref } from '../../lib/routes.ts';
import '../../styles/project-rows.css';

const projects = directoryOrder(await getPublished('projects'));
---

<!--
  Work directory (design-spec §4 `/work`, PRD FR-03): a vertical catalogue of
  published projects between thin rules. From 768px the thumbnail takes the
  leading four grid columns and the text the rest, so a row without a thumbnail
  keeps its text aligned with the others. The markup never depends on how many
  projects there are, so one project reads like any other catalogue (the
  single-project tests rely on this). Type filters are left for later
  (design-spec: "when useful").
-->
<BaseLayout title="Selected Work" description="Things I’ve built: projects and case studies by Daniel Lee Holung.">
  <div class="mx-auto flex max-w-shell flex-col gap-16 px-gutter py-section">
    <header class="flex max-w-measure flex-col gap-8">
      <h1 class="text-page-heading leading-heading font-medium">Things I’ve built.</h1>
      <div class="page-intro flex flex-col gap-4 text-body-large">
        <p>My interests tend to turn into projects.</p>
        <p class="text-muted">
          This is a collection of applications, experiments and ideas I’ve brought to life through software. Some are
          intended to become products. Others are opportunities to explore unfamiliar technologies, test an idea or
          learn something new.
        </p>
      </div>
    </header>

    {
      projects.length === 0 ? (
        <p class="text-body-large text-muted">No projects published yet.</p>
      ) : (
        <ol class="work-list">
          {projects.map(({ id, data }) => (
            <li class="work-row project-row">
              {data.thumbnail && (
                <Image
                  src={data.thumbnail}
                  alt={data.thumbnailAlt ?? ''}
                  widths={[...directoryImage.widths]}
                  sizes={directoryImage.sizes}
                  class="project-thumbnail"
                />
              )}
              <div class="project-body work-body">
                <h2 class="text-section-heading leading-heading font-medium">
                  <a href={entryHref('project', id)} class="entry-link">
                    {data.title}
                  </a>
                </h2>
                <p class="text-muted">{data.summary}</p>
                <dl class="work-meta">
                  <div>
                    <dt>Year</dt>
                    <dd>{data.year}</dd>
                  </div>
                  <div>
                    <dt>Type</dt>
                    <dd>{projectTypeLabels[data.type]}</dd>
                  </div>
                  <div>
                    <dt>Status</dt>
                    <dd>{projectStatusLabels[data.status]}</dd>
                  </div>
                  <div class="work-stack">
                    <dt>Stack</dt>
                    <dd>{data.stack.join(', ')}</dd>
                  </div>
                </dl>
              </div>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</BaseLayout>

<style>
  .page-intro p {
    margin: 0;
    line-height: var(--leading-prose);
  }

  .work-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Row layout, thumbnail and title link: src/styles/project-rows.css. */
  .work-row {
    padding-block: calc(var(--space-unit) * 10);
    border-block-start: var(--rule-width) solid var(--color-rule);
  }

  .work-row:last-child {
    border-block-end: var(--rule-width) solid var(--color-rule);
  }

  .work-body {
    gap: calc(var(--space-unit) * 4);
  }

  /* A title or stack with one long unbroken word still wraps at 320px. */
  .work-body h2,
  .work-meta dd {
    overflow-wrap: anywhere;
  }

  .work-meta {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--space-unit) * 3) calc(var(--space-unit) * 8);
    margin: 0;
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .work-meta dt {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .work-meta dd {
    margin: 0;
  }

  /* The stack can be long, so it takes its own line below year, type and status. */
  .work-stack {
    flex-basis: 100%;
  }
</style>
