{
  "name": "personal-site",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:fixtures": "CONTENT_SOURCE=fixtures astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run test:unit && npm run build && npm run build:fixtures && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "~0.4.10",
    "@astrojs/mdx": "~8.1.6",
    "@astrojs/rss": "~4.0.19",
    "@astrojs/sitemap": "~3.7.6",
    "@tailwindcss/vite": "~4.3.5",
    "astro": "~7.4.13",
    "tailwindcss": "~4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "~0.9.12",
    "@axe-core/playwright": "~4.14.0",
    "@playwright/test": "~1.65.1",
    "@types/hast": "~3.0.4",
    "@types/node": "~24.19.2",
    "typescript": "~6.0.3",
    "wrangler": "~4.165.0"
  }
}
